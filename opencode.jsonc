{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
  },
  "model": "opencode/big-pickle",
  "small_model": "github-copilot/gpt-4.1",
  "provider": {
    "copilot": {
      "models": {
        "gpt-4.1": {
          "options": {
            "textVerbosity": "low",
          },
        },
      },
    },
    "openai": {
      "models": {
        "gpt-5.4-mini": {
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          },
        },
        "gpt-5.4": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          },
        },
      },
    },
  },
}
