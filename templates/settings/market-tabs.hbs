<nav class="market-settings-panel__tabs">
  {{#each tabs}}
    <a class="market-settings-panel__tab-link{{#if (eq this.id ../activeTab)}} active{{/if}}"
       data-tab="{{this.id}}"
       aria-label="{{localize this.label}}">
      <i class="{{this.icon}}"></i>
      <span>{{localize this.label}}</span>
    </a>
  {{/each}}
</nav>
