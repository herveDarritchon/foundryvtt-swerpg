<article class="swerpg chat-message audit-entry-summary">
  <header class="audit-entry-summary__header">
    <img class="audit-entry-summary__avatar" src="{{actorImg}}" alt="{{actorName}}">
    <div class="audit-entry-summary__meta">
      <span class="audit-entry-summary__actor">{{actorName}}</span>
      <span class="audit-entry-summary__title">{{title}}</span>
    </div>
  </header>

  <ul class="audit-entry-summary__list">
    {{#each items}}
    <li class="audit-entry-summary__item audit-entry-summary__item--{{variant}}">
      <i class="{{variantGlyph}} audit-entry-summary__glyph" aria-hidden="true"></i>
      <span class="audit-entry-summary__label">{{eventLabel}}</span>
      {{#if previousValue}}
      <span class="audit-entry-summary__previous">{{previousValue}}</span>
      <span class="audit-entry-summary__arrow" aria-hidden="true">→</span>
      {{/if}}
      <span class="audit-entry-summary__value">{{nextValue}}</span>
    </li>
    {{/each}}
  </ul>
</article>
