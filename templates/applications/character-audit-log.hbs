<section class='swerpg application character-audit-log'>
  <header class='audit-log__header'>
    <div class='audit-log__title-block'>
      <h2 class='audit-log__title'>{{document.name}}</h2>
      <p class='audit-log__subtitle'>{{localize 'SWERPG.AUDIT_LOG.SUBTITLE'}}</p>
    </div>

    <div class='audit-log__filters' role='group' aria-label='{{localize "SWERPG.AUDIT_LOG.FILTER_ARIA"}}'>
      {{#each filters as |filter|}}
        <button
          type='button'
          class='audit-log__filter button framed {{filter.cssClass}}'
          data-action='setFilter'
          data-filter='{{filter.id}}'
          aria-pressed='{{filter.isPressed}}'
        >
          <i class='{{filter.icon}} audit-log__filter-icon' aria-hidden='true'></i>
          {{filter.label}}
        </button>
      {{/each}}
    </div>

    {{#if canExport}}
      <div class='audit-log__export'>
        <button
          type='button'
          class='audit-log__export-button button framed'
          data-action='exportCsv'
          data-tooltip='{{localize "SWERPG.AUDIT_LOG.EXPORT_TOOLTIP"}}'
          aria-label='{{localize "SWERPG.AUDIT_LOG.EXPORT"}}'
        >
          <i class='fa-solid fa-download' aria-hidden='true'></i>
          {{localize 'SWERPG.AUDIT_LOG.EXPORT'}}
        </button>
      </div>
    {{/if}}
  </header>

  {{#if hasEntries}}
    <section class='audit-log__entries'>
      {{#each entries as |entry|}}
        <article class='audit-log-entry audit-log-entry--{{entry.variant}}'>

          <header class='audit-log-entry__header'>
            {{#if entry.actorImg}}
              <img class='audit-log-entry__avatar' src='{{entry.actorImg}}' alt='{{entry.actorName}}'>
            {{/if}}
            <div class='audit-log-entry__meta'>
              <span class='audit-log-entry__date'>{{entry.formattedTimestamp}}</span>
              <span class='audit-log-entry__type'>
                <i class='{{entry.familyIcon}} audit-log-entry__family-icon' aria-hidden='true'></i>
                {{entry.eventLabel}}
              </span>
            </div>
          </header>

          <div class='audit-log-entry__body'>
            <div class='audit-log-entry__change'>
              <i class='{{entry.variantGlyph}} audit-log-entry__variant-glyph' aria-label='{{entry.variantGlyphLabel}}'></i>
              {{#if entry.hasPreviousValue}}
                <span class='audit-log-entry__previous' title='{{entry.previousValue}}'>{{entry.previousValue}}</span>
                <span class='audit-log-entry__arrow' aria-hidden='true'>→</span>
              {{/if}}
              <span class='audit-log-entry__badge' title='{{entry.nextValue}}'>{{entry.nextValue}}</span>
            </div>

            <p class='audit-log-entry__description'>{{entry.description}}</p>
          </div>

          {{#if entry.hasDelta}}
            <footer class='audit-log-entry__footer'>
              <span class='audit-log-entry__delta {{entry.deltaClass}}'>{{entry.formattedDelta}}</span>
            </footer>
          {{/if}}

        </article>
      {{/each}}
    </section>
  {{else}}
    <section class='audit-log__empty'>
      <p>{{emptyLabel}}</p>
    </section>
  {{/if}}
</section>
