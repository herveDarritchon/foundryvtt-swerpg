<section class='swerpg application character-audit-log'>
  <header class='audit-log__header'>
    <div class='audit-log__title-block'>
      <h2 class='audit-log__title'>{{document.name}}</h2>
      <p class='audit-log__subtitle'>{{localize 'SWERPG.AUDIT_LOG.SUBTITLE'}}</p>
    </div>

    <div class='audit-log__filters' role='group' aria-label='{{localize "SWERPG.AUDIT_LOG.FILTER_ARIA"}}'>
      {{#each filters as |filter|}}
        <button
          type='button'
          class='audit-log__filter button framed {{filter.cssClass}}'
          data-action='setFilter'
          data-filter='{{filter.id}}'
          aria-pressed='{{filter.isPressed}}'
          aria-label='{{filter.label}} ({{filter.count}})'
        >
          <i class='{{filter.icon}} audit-log__filter-icon' aria-hidden='true'></i>
          {{filter.label}}
          <span class='audit-log__filter-count' aria-hidden='true'>{{filter.count}}</span>
        </button>
      {{/each}}
    </div>

    <div class='audit-log__toolbar'>
      <div class='audit-log__search'>
        <label for='audit-log-search' class='audit-log__search-label'>
          <i class='fa-solid fa-magnifying-glass' aria-hidden='true'></i>
          <span class='visually-hidden'>{{localize 'SWERPG.AUDIT_LOG.SEARCH.LABEL'}}</span>
        </label>
        <input
          id='audit-log-search'
          type='search'
          class='audit-log__search-input'
          placeholder='{{localize "SWERPG.AUDIT_LOG.SEARCH.PLACEHOLDER"}}'
          value='{{searchQuery}}'
          aria-label='{{localize "SWERPG.AUDIT_LOG.SEARCH.LABEL"}}'
        />
      </div>

      <div class='audit-log__date-range'>
        <label for='audit-log-date-from' class='audit-log__date-label'>
          {{localize 'SWERPG.AUDIT_LOG.DATE.FROM_LABEL'}}
        </label>
        <input
          id='audit-log-date-from'
          type='date'
          class='audit-log__date-from'
          value='{{dateFrom}}'
          aria-label='{{localize "SWERPG.AUDIT_LOG.DATE.FROM_LABEL"}}'
        />
        <label for='audit-log-date-to' class='audit-log__date-label'>
          {{localize 'SWERPG.AUDIT_LOG.DATE.TO_LABEL'}}
        </label>
        <input
          id='audit-log-date-to'
          type='date'
          class='audit-log__date-to'
          value='{{dateTo}}'
          aria-label='{{localize "SWERPG.AUDIT_LOG.DATE.TO_LABEL"}}'
        />
      </div>

      <div class='audit-log__counter' aria-live='polite' aria-atomic='true'>
        {{filteredCount}} / {{totalCount}}
      </div>

      {{#if isFiltered}}
        <button
          type='button'
          class='audit-log__clear-search button framed'
          data-action='clearSearch'
          aria-label='{{localize "SWERPG.AUDIT_LOG.SEARCH.CLEAR"}}'
          data-tooltip='{{localize "SWERPG.AUDIT_LOG.SEARCH.CLEAR"}}'
        >
          <i class='fa-solid fa-xmark' aria-hidden='true'></i>
        </button>
      {{/if}}

      {{#if canExport}}
        <button
          type='button'
          class='audit-log__export-button button framed'
          data-action='exportCsv'
          data-tooltip='{{localize "SWERPG.AUDIT_LOG.EXPORT_TOOLTIP"}}'
          aria-label='{{localize "SWERPG.AUDIT_LOG.EXPORT"}}'
        >
          <i class='fa-solid fa-download' aria-hidden='true'></i>
          {{localize 'SWERPG.AUDIT_LOG.EXPORT'}}
        </button>
      {{/if}}
    </div>
  </header>

  {{#if hasFilteredEntries}}
    <section class='audit-log__entries'>
      {{#each sections as |section|}}
        <div class='audit-log__day-section'>
          <header class='audit-log__day-header'>
            <time class='audit-log__day-label' datetime='{{section.datetimeAttr}}'>{{section.headerLabel}}</time>
          </header>

          {{#each section.entries as |entry|}}
            <article class='audit-log-entry audit-log-entry--{{entry.variant}}'>

              <header class='audit-log-entry__header'>
                {{#if entry.actorImg}}
                  <img class='audit-log-entry__avatar' src='{{entry.actorImg}}' alt='{{entry.actorName}}'>
                {{/if}}
                <div class='audit-log-entry__meta'>
                  <time class='audit-log-entry__time' datetime='{{entry.entryDatetimeAttr}}'>{{entry.timeOnly}}</time>
                  <span class='audit-log-entry__type'>
                    <i class='{{entry.familyIcon}} audit-log-entry__family-icon' aria-hidden='true'></i>
                    {{entry.eventLabel}}
                  </span>
                </div>
              </header>

              <div class='audit-log-entry__body'>
                <div class='audit-log-entry__change'>
                  <i class='{{entry.variantGlyph}} audit-log-entry__variant-glyph' aria-label='{{entry.variantGlyphLabel}}'></i>
                  {{#if entry.hasPreviousValue}}
                    <span class='audit-log-entry__previous' title='{{entry.previousValue}}'>{{entry.previousValue}}</span>
                    <span class='audit-log-entry__arrow' aria-hidden='true'>→</span>
                  {{/if}}
                  <span class='audit-log-entry__badge' title='{{entry.nextValue}}'>{{entry.nextValue}}</span>
                </div>

                <p class='audit-log-entry__description'>{{entry.description}}</p>
              </div>

              {{#if entry.hasDelta}}
                <footer class='audit-log-entry__footer'>
                  <span class='audit-log-entry__delta {{entry.deltaClass}} {{entry.deltaUnitClass}}'>
                    {{#if entry.deltaUnitIcon}}
                      <i class='{{entry.deltaUnitIcon}} audit-log-entry__delta-unit-icon' aria-hidden='true'></i>
                    {{/if}}
                    <span class='audit-log-entry__delta-value'>{{entry.formattedDelta}}</span>
                    {{#if entry.deltaUnitLabel}}
                      <span class='visually-hidden'>{{entry.deltaUnitLabel}}</span>
                    {{/if}}
                  </span>
                </footer>
              {{/if}}

            </article>
          {{/each}}
        </div>
      {{/each}}
    </section>
  {{else if isActiveFamilyEmpty}}
    <section class='audit-log__empty audit-log__empty--family'>
      <i class='fa-solid fa-filter audit-log__empty-icon' aria-hidden='true'></i>
      <p>{{emptyFamilyLabel}}</p>
    </section>
  {{else if hasEntries}}
    <section class='audit-log__empty audit-log__empty--filtered'>
      <i class='fa-solid fa-magnifying-glass audit-log__empty-icon' aria-hidden='true'></i>
      <p>{{emptyFilteredLabel}}</p>
    </section>
  {{else}}
    <section class='audit-log__empty audit-log__empty--log' aria-label='{{emptyState.title}}'>
      <i class='{{emptyState.icon}} audit-log__empty-icon' aria-hidden='true'></i>
      <h3 class='audit-log__empty-title'>{{emptyState.title}}</h3>
      <p class='audit-log__empty-hint'>{{emptyState.hint}}</p>
    </section>
  {{/if}}
</section>
