# Configuration E2E documentation — instance Foundry sur port 30000
# Copier ce fichier en .env.e2e.documentation et remplir les valeurs.
# Ce fichier ne doit JAMAIS être commité.
#
# Usage :
#   cp .env.e2e.documentation.example .env.e2e.documentation
#   pnpm e2e:documentation
#
# Périmètre :
#   La suite documentation produit des captures d'écran et valide les invariants
#   visibles (i18n, placeholders, absence d'erreurs navigateur) sur les parcours
#   documentaires. Elle est en LECTURE SEULE par défaut.
#   Des prérequis contrôlés (état stable documenté) peuvent être autorisés spec par spec,
#   à condition d'être explicitement documentés dans la spec concernée.

# URL de l'instance Foundry utilisée pour la documentation (production ou instance dédiée)
E2E_FOUNDRY_BASE_URL=http://localhost:30000

# Mot de passe administrateur Foundry (page /auth)
E2E_FOUNDRY_ADMIN_PASSWORD=your_admin_password_here

# Identifiants du compte utilisé pour les specs documentation
E2E_FOUNDRY_USERNAME=Gamemaster
E2E_FOUNDRY_PASSWORD=

# Monde stable utilisé pour la documentation
# Doit être dans un état stable et représentatif des captures attendues.
E2E_FOUNDRY_WORLD=test-v14-309