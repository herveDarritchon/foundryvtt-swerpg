# Configuration E2E de non-régression — instance Foundry sur port 31001
# Copier ce fichier en .env.e2e.regression et remplir les valeurs

# URL de l'instance Foundry dédiée aux tests de non-régression
E2E_FOUNDRY_BASE_URL=http://localhost:31001

# Mot de passe administrateur Foundry (page /auth)
E2E_FOUNDRY_ADMIN_PASSWORD=your_admin_password_here

# Identifiants Gamemaster
E2E_FOUNDRY_USERNAME=Gamemaster
E2E_FOUNDRY_PASSWORD=

# Monde de non-régression (monde vierge dédié, ne pas utiliser le monde de dev)
E2E_FOUNDRY_WORLD=Swerpg-Regression-World

# Chemin absolu vers le ZIP OggDude pour les tests d'import
# Défaut : e2e/fixtures/oggdude-data.zip (placer le fichier ici ou surcharger cette variable)
# E2E_OGGDUDE_ZIP_PATH=/chemin/absolu/vers/oggdude-data.zip