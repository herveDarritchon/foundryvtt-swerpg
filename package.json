{
  "name": "swerpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run fmt && pnpm run rollup && pnpm run less",
    "rollup:watch": "rollup --config rollup.config.mjs --watch",
    "rollup": "rollup --config",
    "rollup:dev": "rollup --config rollup.config.dev.mjs",
    "rollup:dev:watch": "rollup --config rollup.config.dev.mjs --watch",
    "less": "gulp css",
    "less:watch": "gulp watch:css",
    "dev:css": "pnpm run less:watch",
    "compile": "node build.mjs compile",
    "extract": "node build.mjs extract",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --watch --config vitest.config.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.mjs",
    "e2e": "pnpm run e2e:regression && pnpm run e2e:smoke",
    "e2e:ci": "playwright test --config playwright.config.ts --project=chromium --grep \"\\[ci\\]\"",
    "e2e:regression": "playwright test --config playwright.regression.config.ts",
    "e2e:regression:headed": "playwright test --config playwright.regression.config.ts --headed",
    "e2e:regression:ui": "playwright test --config playwright.regression.config.ts --ui",
    "e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "e2e:smoke:headed": "playwright test --config playwright.smoke.config.ts --headed",
    "e2e:documentation": "playwright test --config playwright.documentation.config.ts --pass-with-no-tests",
    "e2e:documentation:headed": "playwright test --config playwright.documentation.config.ts --headed --pass-with-no-tests",
    "e2e:documentation:ui": "playwright test --config playwright.documentation.config.ts --ui",
    "e2e:regression:report": "playwright test --config playwright.regression.config.ts && playwright show-report playwright-regression-report",
    "e2e:smoke:report": "playwright test --config playwright.smoke.config.ts && playwright show-report playwright-smoke-report",
    "e2e:documentation:report": "playwright test --config playwright.documentation.config.ts --pass-with-no-tests && playwright show-report playwright-documentation-report",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint module/**/*.js module/**/*.mjs tests/**/*.js tests/**/*.mjs",
    "lint:fix": "eslint module/**/*.js module/**/*.mjs tests/**/*.js tests/**/*.mjs --fix",
    "foundry:e2e:start": "bash ./scripts/e2e-foundry-start.sh start",
    "foundry:e2e:stop": "bash ./scripts/e2e-foundry-start.sh stop",
    "foundry:e2e:restart": "bash ./scripts/e2e-foundry-start.sh restart",
    "docs:generate-user-guides": "node e2e/documentation/utils/markdown-guide-generator.mjs",
    "docs:generate-user-guides:html": "node e2e/documentation/utils/html-guide-generator.mjs",
    "docs:generate-all": "pnpm run docs:generate-user-guides && pnpm run docs:generate-user-guides:html",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^28.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^3.1.1",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.9.0",
    "gulp": "^5.0.0",
    "gulp-less": "^5.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-touch-cmd": "^0.0.1",
    "husky": "^9.1.7",
    "less": "^4.3.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.6.2",
    "prettier-plugin-handlebars": "^0.0.1",
    "rollup": "^4.41.1",
    "semantic-release": "^24.2.5",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{hbs,json,md,less,yml,yaml}": [
      "prettier --write"
    ]
  },
  "author": "Behaska",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1"
  }
}
